rules_version = '2';

// Paste this into: Firebase Console → Firestore Database → Rules tab → Publish.
//
// What this does: each signed-in user gets their own private space at
// /users/{their-uid}/jobs/{jobId}. A request can only read or write documents
// under their own uid — Firebase checks this on every request, so it doesn't
// matter that the app's config (including the API key) is visible in the
// public page source. That's normal for Firebase web apps; the config just
// identifies which project to talk to, it doesn't grant access by itself.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/jobs/{jobId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Everything else is denied by default (no rule = no access).
  }
}
